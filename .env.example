# Public browser configuration. Supabase anon keys are public by design;
# security depends on RLS and JWT verification remaining enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_AI_GATEWAY_URL=
NEXT_PUBLIC_AI_PROVIDER=gemini

# Server-only secrets for the Supabase Edge Function. Never prefix these with
# NEXT_PUBLIC_ and never add real values to Git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
ALLOWED_ORIGINS=http://localhost:4173
PUBLIC_APP_URL=http://localhost:4173
AI_REQUESTS_PER_MINUTE=10

# Roadmap adapters (not used by the current browser client).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
OLLAMA_BASE_URL=http://127.0.0.1:11434
